From 3ae2669a3d53fd0a564657d1253debdf77e2a241 Mon Sep 17 00:00:00 2001
From: Tristan Matthews <tmatth@videolan.org>
Date: Thu, 30 Apr 2026 10:14:03 -0400
Subject: [PATCH] autotools: relax autoconf requirement

2.69 is much more widely available than 2.71 and works fine.
---
 configure.ac | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index acfb9890..5e9e350f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -14,7 +14,7 @@ AM_MAINTAINER_MODE([enable])
 
 dnl we use doc_DATA in doc/Makefile.am which requires autoconf >= 2.60
 dnl to define docdir for us.
-AC_PREREQ([2.71])
+AC_PREREQ([2.69])
 
 m4_ifdef([AM_SILENT_RULES], [AM_SILENT_RULES([yes])])
 
